# ── Vercel env vars (ustaw w `vercel env add` lub w Project Settings → Environment Variables) ──

# ADO connection
ADO_ORG=your-organization
ADO_PROJECT=Your Project Name
ADO_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcjonalne — jeśli puste, użyjemy @CurrentIteration
ADO_ITERATION=
ADO_TEAM=

# Opcjonalne — filtr area path (UNDER), np. "Mezzanine\DataFlow\Non-Extraction\Synergy"
ADO_AREA_PATH=

ADO_API_VERSION=7.1

# Basic Auth dla całego /api/ado/* (gate dla osób na daily)
DEMO_USER=daily
DEMO_PASS=change-me-strong-password
